# =============================================================================
# Endpoint Ledger environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# All values can also be supplied via the shell environment.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (SQLAlchemy URL, psycopg driver).
# With `docker compose up -d db`:
ENDPOINT_LEDGER_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/endpoint_ledger
# With a local Homebrew PostgreSQL:
# ENDPOINT_LEDGER_DATABASE_URL=postgresql+psycopg://localhost:5432/endpoint_ledger

# --- Probes ------------------------------------------------------------------
# Directory (relative to the project root) holding the version-controlled
# probe definitions that make up the "smoke" suite.
ENDPOINT_LEDGER_PROBES_DIR=probes/smoke

# --- OpenAI ------------------------------------------------------------------
# Live OpenAI runs are opt-in. Leave empty/unset to keep the OpenAI endpoint
# in a clear "unavailable" state (the app will not pretend to run it).
OPENAI_API_KEY=
# Model identifier for the seeded OpenAI endpoint. Loaded through config, never
# hardcoded in application logic.
ENDPOINT_LEDGER_OPENAI_MODEL=gpt-4o-mini
ENDPOINT_LEDGER_OPENAI_TIMEOUT_SECONDS=60
ENDPOINT_LEDGER_OPENAI_MAX_RETRIES=3

# --- Dashboard ---------------------------------------------------------------
# Whether raw provider responses are rendered in the web UI. Defaults to false.
# Keep this false outside local development.
ENDPOINT_LEDGER_SHOW_RAW_RESPONSES=false

# --- Runner ------------------------------------------------------------------
# Per-run cost ceiling in USD. A live run whose estimated maximum cost exceeds
# this is refused before it begins. If endpoint pricing is not configured the
# cost is reported as unknown and the ceiling is not enforced.
ENDPOINT_LEDGER_COST_CEILING_USD=5.0
# Mock provider latency characteristics (ms).
ENDPOINT_LEDGER_MOCK_LATENCY_BASE_MS=120
ENDPOINT_LEDGER_MOCK_LATENCY_JITTER_MS=15

# --- Change detection ----------------------------------------------------------
ENDPOINT_LEDGER_CHANGE_DETECTION_MIN_OBSERVATIONS=5
ENDPOINT_LEDGER_CHANGE_DETECTION_MIN_ABSOLUTE_CHANGE=0.25
ENDPOINT_LEDGER_CHANGE_DETECTION_ALPHA=0.05
# Optional ISO-8601 boundary: observations completed after this timestamp are
# the "current" window; at or before it are the "baseline" window. When unset,
# a default boundary of now - 7 days is used.
ENDPOINT_LEDGER_CHANGE_DETECTION_SPLIT_AFTER=

# --- Measurement integrity / baseline qualification -----------------------------
# Serving surface recorded in cohort fingerprints.
ENDPOINT_LEDGER_SERVING_SURFACE=openai-chat-completions-v1
# Explicit compatibility version; bump deliberately when the runner changes in
# a way that could alter measured behavior.
ENDPOINT_LEDGER_RUNNER_COMPAT_VERSION=0.1.0
# Baseline qualification policy (MVP defaults).
ENDPOINT_LEDGER_BASELINE_MIN_CALENDAR_DAYS=7
ENDPOINT_LEDGER_BASELINE_MIN_DISTINCT_RUNS=10
ENDPOINT_LEDGER_BASELINE_MIN_PRIMARY_OBSERVATIONS=50
ENDPOINT_LEDGER_BASELINE_MIN_DISTINCT_DATES=5

# --- Evidence durability (Phase 1.2) -------------------------------------------
# Backup directory (outside version control) and maximum acceptable age of a
# verified backup before destructive maintenance may run while live evidence
# exists.
ENDPOINT_LEDGER_BACKUP_DIR=.backups
ENDPOINT_LEDGER_BACKUP_MAX_AGE_HOURS=24
ENDPOINT_LEDGER_REQUIRE_BACKUP_BEFORE_MAINTENANCE=true
# Directory for portable run evidence bundles.
ENDPOINT_LEDGER_EVIDENCE_EXPORT_DIR=evidence_exports
# Run-level change detection thresholds for live claims.
ENDPOINT_LEDGER_CHANGE_DETECTION_MIN_BASELINE_RUNS=10
ENDPOINT_LEDGER_CHANGE_DETECTION_MIN_CURRENT_RUNS=3
ENDPOINT_LEDGER_CHANGE_DETECTION_MIN_CURRENT_DATES=2
ENDPOINT_LEDGER_CHANGE_DETECTION_MATERIAL_EFFECT=0.2
ENDPOINT_LEDGER_CHANGE_DETECTION_REQUIRE_DIRECTION_CONSISTENCY=true
ENDPOINT_LEDGER_CHANGE_DETECTION_PERMUTATIONS=2000
